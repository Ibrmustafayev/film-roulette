# ---------------------------------------------------------------------------
# Film Roulette — environment template
# Copy to .env.local and fill in. .env.local is git-ignored; never commit keys.
# ---------------------------------------------------------------------------

# TMDB — required. Without these the roulette, search and every detail page
# return 401 and the app renders empty. https://www.themoviedb.org/settings/api
# Either the v3 key or the v4 read access token works; setting both is fine.
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=

# Supabase — required. Auth, watch-party rooms and comments fail to load
# without them; the app throws at startup rather than half-working.
# Project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ — that would ship it to the
# browser. Used solely by getServiceSupabase() for admin-side queries.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — optional. Only the feedback form uses it; without it the form
# reports a send failure. https://resend.com
RESEND_API_KEY=
